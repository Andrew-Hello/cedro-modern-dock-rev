<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CedroModernDock.ViewModels"
        x:Class="CedroModernDock.Views.AddWindowsModulesWindow"
        x:DataType="vm:AddWindowsModulesViewModel"
        Title="{Binding Title}"
        Width="420" Height="360"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <ScrollViewer Padding="24">
        <StackPanel Orientation="Vertical" Spacing="16">
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="#AAAAAA" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding AvailableTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding AvailableHelper}" FontSize="12" Foreground="#888888" TextWrapping="Wrap"/>
            <ListBox ItemsSource="{Binding ModuleNames}"
                     SelectedIndex="{Binding SelectedIndex}"
                     Background="#2D2D2D" Foreground="White"
                     BorderBrush="#444444" BorderThickness="1"
                     MinHeight="120" MaxHeight="120"
                     Margin="0,4,0,0"/>
            <Button Content="{Binding AddButtonText}"
                    Click="OnAddSelected"
                    HorizontalAlignment="Right"
                    Background="#007ACC" Foreground="White"
                    Padding="20,8" BorderBrush="Transparent"/>
        </StackPanel>
    </ScrollViewer>
</Window>

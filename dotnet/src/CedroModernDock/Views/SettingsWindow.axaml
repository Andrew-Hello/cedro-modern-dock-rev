<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CedroModernDock.ViewModels"
        xmlns:med="using:Avalonia.Media"
        x:Class="CedroModernDock.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/icons/cedro/logo_256.png"
        Width="1000" Height="700"
        MinWidth="860" MinHeight="600"
        MaxWidth="1180" MaxHeight="900"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="#181818"
        Closed="OnClosed">

    <Window.Resources>
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#007ACC"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#168BD2"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#0063A6"/>
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#007ACC"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#168BD2"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#0063A6"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#007ACC"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#007ACC"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#007ACC"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#007ACC"/>
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TabControl">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" Spacing="4"/>
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Width" Value="176"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BEBEBE"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#292929"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Background" Value="#263A4A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Button"><Setter Property="Cursor" Value="Hand"/></Style>
        <Style Selector="CheckBox"><Setter Property="Cursor" Value="Hand"/></Style>
        <Style Selector="RadioButton"><Setter Property="Cursor" Value="Hand"/></Style>
        <Style Selector="ComboBox"><Setter Property="Cursor" Value="Hand"/></Style>
        <Style Selector="ComboBoxItem"><Setter Property="Cursor" Value="Hand"/></Style>
        <Style Selector="Slider"><Setter Property="Cursor" Value="Hand"/></Style>
        <Style Selector="ScrollBar"><Setter Property="AllowAutoHide" Value="False"/></Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="#202020" BorderBrush="#303030" BorderThickness="0,0,0,1" Padding="22,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding PageTitle}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Cedro Modern Dock" FontSize="11" Foreground="#777777"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LanguageLabel}" VerticalAlignment="Center" Foreground="#AAAAAA"/>
                    <ComboBox ItemsSource="{Binding LanguageNames}" SelectedIndex="{Binding SelectedLanguageIndex}"
                              Width="170" Background="#2D2D2D" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" TabStripPlacement="Left" Background="Transparent" Padding="12,14,16,16">
            <!-- Dock items -->
            <TabItem Header="{Binding TabIcons}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
                    <Grid ColumnDefinitions="300,*" ColumnSpacing="16" MaxWidth="820" HorizontalAlignment="Left" Margin="10,0,6,12">
                        <Border Grid.Column="0" Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Text="{Binding ItemsTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,0,0,10"/>
                                <Grid Grid.Row="1">
                                    <ListBox x:Name="ItemsList" ItemsSource="{Binding ItemEntries}" SelectedIndex="{Binding SelectedItemIndex}"
                                             Background="#2A2A2A" Foreground="White" BorderBrush="#444" BorderThickness="1"
                                             Height="470" Cursor="SizeAll"
                                             DragDrop.AllowDrop="True"
                                             DragDrop.DragOver="OnItemsDragOver"
                                             DragDrop.DragLeave="OnItemsDragLeave"
                                             DragDrop.Drop="OnItemsDrop"
                                             PointerMoved="OnItemsPointerMoved"
                                             PointerReleased="OnItemsPointerReleased"
                                             PointerCaptureLost="OnItemsPointerCaptureLost">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DockItemListEntry">
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,3">
                                                    <Image Source="/Assets/icons/draggable.png" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Opacity="0.5"/>
                                                    <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Border x:Name="DropIndicator" IsVisible="False" Height="2" Background="#007ACC" CornerRadius="1" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="14">
                            <Border Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding ActionsTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                                    <TextBlock Text="{Binding ActionsHelper}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                        <Button Grid.Row="0" Grid.Column="0" Content="{Binding AddProgramText}" Click="OnAddProgram" Background="#007ACC" Foreground="White" BorderBrush="Transparent" Padding="12,7"/>
                                        <Button Grid.Row="0" Grid.Column="1" Content="{Binding AddFolderText}" Click="OnAddFolder" Background="#007ACC" Foreground="White" BorderBrush="Transparent" Padding="12,7"/>
                                        <Button Grid.Row="1" Grid.Column="0" Content="{Binding AddModuleText}" Click="OnAddModule" Background="#3A3A3A" Foreground="White" BorderBrush="Transparent" Padding="12,7"/>
                                        <Button Grid.Row="1" Grid.Column="1" Content="{Binding AddScriptText}" Click="OnAddScript" Background="#3A3A3A" Foreground="White" BorderBrush="Transparent" Padding="12,7"/>
                                        <Button Grid.Row="2" Grid.Column="0" Content="{Binding MoveUpText}" Click="OnMoveUp" IsEnabled="{Binding CanMoveUp}" Background="#3A3A3A" Foreground="White" BorderBrush="Transparent" Padding="12,7"/>
                                        <Button Grid.Row="2" Grid.Column="1" Content="{Binding MoveDownText}" Click="OnMoveDown" IsEnabled="{Binding CanMoveDown}" Background="#3A3A3A" Foreground="White" BorderBrush="Transparent" Padding="12,7"/>
                                    </Grid>
                                    <Button Content="{Binding RemoveText}" Click="OnRemove" IsEnabled="{Binding CanRemove}" Background="#8C3838" Foreground="White" BorderBrush="Transparent" Padding="12,7" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="{Binding CustomIconTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                                    <TextBlock Text="{Binding CustomIconHelper}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                                    <Button Content="{Binding ChooseCustomIconText}" Click="OnChooseCustomIcon" IsEnabled="{Binding CanCustomizeIcon}" Background="#007ACC" Foreground="White" BorderBrush="Transparent" Padding="12,7" HorizontalAlignment="Stretch"/>
                                    <Button Content="{Binding ChooseSystemIconText}" Click="OnChooseSystemIcon" IsEnabled="{Binding CanCustomizeIcon}" Background="#3A3A3A" Foreground="White" BorderBrush="Transparent" Padding="12,7" HorizontalAlignment="Stretch"/>
                                    <Button Content="{Binding ResetCustomIconText}" Click="OnResetCustomIcon" IsEnabled="{Binding CanResetCustomIcon}" Background="#3A3A3A" Foreground="White" BorderBrush="Transparent" Padding="12,7" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Positioning -->
            <TabItem Header="{Binding TabDockPositioning}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left" Spacing="14" Margin="10,0,6,12">
                        <Border Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding PosModeTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                                <TextBlock Text="{Binding PosModeHelper}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="22">
                                    <RadioButton Content="{Binding StaticText}" IsChecked="{Binding IsStaticPositioningSelected}" Foreground="White" GroupName="PositioningMode"/>
                                    <RadioButton Content="{Binding DynamicText}" IsChecked="{Binding IsDynamicPositioningSelected}" Foreground="White" GroupName="PositioningMode"/>
                                    <RadioButton Content="{Binding BottomAppBarText}" IsChecked="{Binding IsBottomAppBarMode}" Foreground="White" GroupName="PositioningMode"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border IsVisible="{Binding IsStaticPositioningSelected}" Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="22">
                                <StackPanel Grid.Column="0" Spacing="10">
                                    <TextBlock Text="{Binding AlignmentTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#D8D8D8"/>
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                                        <TextBlock Grid.Row="0" Text="{Binding VerticalText}" Foreground="#AAA" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding VerticalAnchorOptions}" SelectedItem="{Binding SelectedVerticalOption}" Background="#2D2D2D" Foreground="White"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:AnchorOption"><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                        <TextBlock Grid.Row="1" Text="{Binding HorizontalText}" Foreground="#AAA" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding HorizontalAnchorOptions}" SelectedItem="{Binding SelectedHorizontalOption}" Background="#2D2D2D" Foreground="White"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:HorizontalAnchorOption"><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="7">
                                    <TextBlock Text="{Binding ScreenSpacingTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#D8D8D8" Margin="0,0,0,3"/>
                                    <Grid ColumnDefinitions="52,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                                        <TextBlock Grid.Row="0" Text="{Binding TopSpacingLabel}" Foreground="#AAA" VerticalAlignment="Center"/><Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding TopSpacing}"/>
                                        <TextBlock Grid.Row="1" Text="{Binding LeftSpacingLabel}" Foreground="#AAA" VerticalAlignment="Center"/><Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding LeftSpacing}"/>
                                        <TextBlock Grid.Row="2" Text="{Binding RightSpacingLabel}" Foreground="#AAA" VerticalAlignment="Center"/><Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding RightSpacing}"/>
                                        <TextBlock Grid.Row="3" Text="{Binding BottomSpacingLabel}" Foreground="#AAA" VerticalAlignment="Center"/><Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BottomSpacing}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border IsVisible="{Binding IsDynamicPositioningSelected}" Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="7"><TextBlock Text="{Binding DynamicPosTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#E0E0E0"/><TextBlock Text="{Binding DynamicPosHelper}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/></StackPanel>
                        </Border>

                        <Border IsVisible="{Binding IsBottomAppBarMode}" Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding BottomAppBarTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                                <TextBlock Text="{Binding BottomAppBarHelper}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding BottomAppBarAlignmentTitle}" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,4,0,0"/>
                                <ComboBox Width="220" HorizontalAlignment="Left" ItemsSource="{Binding HorizontalAnchorOptions}" SelectedItem="{Binding SelectedHorizontalOption}" Background="#2D2D2D" Foreground="White"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:HorizontalAnchorOption"><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Dock appearance -->
            <TabItem Header="{Binding TabDockCustomization}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
                    <Grid MaxWidth="820" HorizontalAlignment="Left" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14" Margin="10,0,6,12">
                        <Border Grid.Row="0" Grid.Column="0" Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel Spacing="7"><TextBlock Text="{Binding TransparencyTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#D8D8D8"/><TextBlock Text="{Binding TransparencyHelper}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/><Slider Minimum="0" Maximum="100" Value="{Binding Transparency}" Margin="0,7,0,0"/></StackPanel></Border>
                        <Border Grid.Row="0" Grid.Column="1" Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel Spacing="7"><TextBlock Text="{Binding RoundingTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#D8D8D8"/><TextBlock Text="{Binding RoundingHelper}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/><Slider Minimum="0" Maximum="30" Value="{Binding BorderRounding}" Margin="0,7,0,0"/></StackPanel></Border>
                        <Border Grid.Row="1" Grid.Column="0" Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel Spacing="7"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding VerticalPaddingTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#D8D8D8"/><TextBlock Grid.Column="1" Text="{Binding DockVerticalPadding}" Foreground="#AAAAAA"/></Grid><TextBlock Text="{Binding VerticalPaddingHelper}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/><Slider Minimum="0" Maximum="20" Value="{Binding DockVerticalPadding}" Margin="0,7,0,0"/></StackPanel></Border>
                        <Border Grid.Row="1" Grid.Column="1" Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="7">
                                <TextBlock Text="{Binding BgColorTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#D8D8D8"/>
                                <TextBlock Text="{Binding BgColorHelper}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,4,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="med:IBrush"><Border Width="28" Height="28" Margin="0,0,6,6" CornerRadius="5" Background="{Binding}" BorderBrush="#666" BorderThickness="1" PointerPressed="OnPresetColorPressed"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <StackPanel Orientation="Horizontal" Spacing="10"><Border Width="42" Height="28" CornerRadius="5" BorderBrush="#666" BorderThickness="1" Background="{Binding DockColorBrush}"/><Button Content="{Binding CustomColorText}" Click="OnCustomColor" Background="#3A3A3A" Foreground="White" BorderBrush="Transparent" Padding="12,5"/></StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Icon appearance -->
            <TabItem Header="{Binding TabIconsCustomization}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left" Spacing="14" Margin="10,0,6,12">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <Border Grid.Column="0" Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel Spacing="7"><TextBlock Text="{Binding IconSizeTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#D8D8D8"/><TextBlock Text="{Binding IconSizeHelper}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/><Slider Minimum="16" Maximum="80" Value="{Binding IconSize}" Margin="0,7,0,0"/></StackPanel></Border>
                            <Border Grid.Column="1" Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel Spacing="7"><TextBlock Text="{Binding SpacingTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#D8D8D8"/><TextBlock Text="{Binding SpacingHelper}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/><Slider Minimum="0" Maximum="20" Value="{Binding IconSpacing}" Margin="0,7,0,0"/></StackPanel></Border>
                        </Grid>
                        <Border Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">
                                <CheckBox Content="{Binding TintIconsTitle}" IsChecked="{Binding TintIcons}" Foreground="#D8D8D8" FontWeight="SemiBold"/>
                                <StackPanel Spacing="7" IsVisible="{Binding TintIcons}">
                                    <TextBlock Text="{Binding TintColorHelper}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding PresetColors}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="med:IBrush"><Border Width="28" Height="28" Margin="0,0,6,6" CornerRadius="5" Background="{Binding}" BorderBrush="#666" BorderThickness="1" PointerPressed="OnTintPresetColorPressed"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    <StackPanel Orientation="Horizontal" Spacing="10"><Border Width="42" Height="28" CornerRadius="5" BorderBrush="#666" BorderThickness="1" Background="{Binding TintColorBrush}"/><Button Content="{Binding CustomColorText}" Click="OnCustomTintColor" Background="#3A3A3A" Foreground="White" BorderBrush="Transparent" Padding="12,5"/></StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- General -->
            <TabItem Header="{Binding TabGeneral}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
                    <Grid MaxWidth="820" HorizontalAlignment="Left" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14" Margin="10,0,6,12">
                        <Border Grid.Row="0" Grid.Column="0" Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel Spacing="8"><TextBlock Text="{Binding OpenSourceText}" FontSize="15" FontWeight="SemiBold" Foreground="#E0E0E0"/><CheckBox Content="{Binding StartWithWindowsText}" IsChecked="{Binding IsAutoStartEnabled}" Foreground="#CCCCCC"/><CheckBox Content="{Binding ShowUnpinnedRunningAppsText}" IsChecked="{Binding ShowUnpinnedRunningApps}" Foreground="#CCCCCC"/><CheckBox Content="{Binding ArrangeVerticalText}" IsChecked="{Binding IsVerticalDock}" IsEnabled="{Binding CanArrangeVertical}" Foreground="#CCCCCC"/></StackPanel></Border>
                        <Border Grid.Row="0" Grid.Column="1" Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel Spacing="6"><TextBlock Text="{Binding WindowBehaviorTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#E0E0E0"/><CheckBox Content="{Binding AlwaysOnTopTitle}" IsChecked="{Binding AlwaysOnTop}" Foreground="#CCCCCC"/><TextBlock Text="{Binding AlwaysOnTopHelper}" FontSize="10.5" Foreground="#777777" TextWrapping="Wrap" Margin="22,-2,0,3"/><CheckBox Content="{Binding HorizontalEdgeAutoHideTitle}" IsChecked="{Binding AutoHideAtHorizontalEdges}" IsEnabled="{Binding !IsBottomAppBarMode}" Foreground="#CCCCCC"/><CheckBox Content="{Binding VerticalEdgeAutoHideTitle}" IsChecked="{Binding AutoHideAtVerticalEdges}" IsEnabled="{Binding !IsBottomAppBarMode}" Foreground="#CCCCCC"/></StackPanel></Border>
                        <Border Grid.Row="1" Grid.Column="0" Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel Spacing="6"><TextBlock Text="{Binding DockInteractionTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#E0E0E0"/><CheckBox Content="{Binding RunningIndicatorsTitle}" IsChecked="{Binding ShowRunningIndicators}" Foreground="#CCCCCC"/><CheckBox Content="{Binding HoverMagnificationTitle}" IsChecked="{Binding EnableHoverMagnification}" Foreground="#CCCCCC"/><CheckBox Content="{Binding HoverLabelsTitle}" IsChecked="{Binding ShowHoverLabels}" Foreground="#CCCCCC"/><CheckBox Content="{Binding WindowPreviewsTitle}" IsChecked="{Binding ShowWindowPreviews}" Foreground="#CCCCCC"/></StackPanel></Border>
                        <Border Grid.Row="1" Grid.Column="1" Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding ConfigBackupTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                                <TextBlock Text="{Binding ConfigBackupHelper}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8"><Button Grid.Row="0" Grid.Column="0" Content="{Binding OpenBackupFolderText}" Click="OnOpenBackupFolder" Background="#3A3A3A" Foreground="White" BorderBrush="Transparent" Padding="10,6"/><Button Grid.Row="0" Grid.Column="1" Content="{Binding ExportConfigText}" Click="OnExportConfig" Background="#3A3A3A" Foreground="White" BorderBrush="Transparent" Padding="10,6"/><Button Grid.Row="1" Grid.ColumnSpan="2" Content="{Binding ImportConfigText}" Click="OnImportConfig" Background="#3A3A3A" Foreground="White" BorderBrush="Transparent" Padding="10,6"/></Grid>
                                <Border Height="1" Background="#333333" Margin="0,5,0,3"/>
                                <Button Content="{Binding AcknowledgementsText}" Click="OnAcknowledgements" Background="#3A3A3A" Foreground="White" BorderBrush="Transparent" Padding="10,6" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding VersionText}" Foreground="#999999" FontSize="11"/>
                                <TextBlock Text="{Binding RepoText}" Foreground="#777777" FontSize="10.5" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ContactText}" Foreground="#777777" FontSize="10.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>